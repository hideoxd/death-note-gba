{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "dialogue-tree.schema.json",
  "title": "Death Note Dialogue Tree",
  "type": "object",
  "required": ["meta", "nodes"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["id", "version", "mode", "startNodeId"],
      "properties": {
        "id": { "type": "string" },
        "version": { "type": "integer", "minimum": 1 },
        "mode": { "type": "string", "enum": ["anime-canon", "divergent"] },
        "startNodeId": { "type": "string" }
      },
      "additionalProperties": false
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/node"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "type", "text"],
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["scene", "choice", "event", "system"] },
        "speaker": { "type": "string" },
        "portrait": { "type": "string" },
        "location": { "type": "string" },
        "text": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement" }
        },
        "onEnter": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" }
        },
        "choices": {
          "type": "array",
          "items": { "$ref": "#/$defs/choice" }
        },
        "next": {
          "type": ["string", "null"]
        },
        "canon": {
          "type": "object",
          "required": ["milestoneId", "deadline", "failureNodeId"],
          "properties": {
            "milestoneId": { "type": "string" },
            "deadline": {
              "type": "object",
              "required": ["day", "block"],
              "properties": {
                "day": { "type": "integer", "minimum": 1 },
                "block": { "type": "string", "enum": ["morning", "afternoon", "night"] }
              },
              "additionalProperties": false
            },
            "failureNodeId": { "type": "string" }
          },
          "additionalProperties": false
        },
        "tags": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "choice": {
      "type": "object",
      "required": ["id", "label", "next"],
      "properties": {
        "id": { "type": "string" },
        "label": { "type": "string" },
        "requirements": {
          "type": "array",
          "items": { "$ref": "#/$defs/requirement" }
        },
        "effects": {
          "type": "array",
          "items": { "$ref": "#/$defs/effect" }
        },
        "next": { "type": "string" }
      },
      "additionalProperties": false
    },
    "requirement": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "compare",
            "flag.is",
            "mode.is",
            "time.window",
            "milestone.state",
            "relationship.compare"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "compare" } } },
          "then": {
            "required": ["path", "op", "value"],
            "properties": {
              "path": { "type": "string" },
              "op": { "type": "string", "enum": ["=", "!=", ">", ">=", "<", "<="] },
              "value": {}
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "flag.is" } } },
          "then": {
            "required": ["key", "value"],
            "properties": {
              "key": { "type": "string" },
              "value": {}
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "mode.is" } } },
          "then": {
            "required": ["value"],
            "properties": {
              "value": { "type": "string", "enum": ["anime-canon", "divergent"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "time.window" } } },
          "then": {
            "properties": {
              "dayMin": { "type": "integer", "minimum": 1 },
              "dayMax": { "type": "integer", "minimum": 1 },
              "blocks": {
                "type": "array",
                "items": { "type": "string", "enum": ["morning", "afternoon", "night"] }
              }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "milestone.state" } } },
          "then": {
            "required": ["milestoneId", "state"],
            "properties": {
              "milestoneId": { "type": "string" },
              "state": { "type": "string", "enum": ["locked", "active", "completed", "failed"] }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "relationship.compare" } } },
          "then": {
            "required": ["characterId", "metric", "op", "value"],
            "properties": {
              "characterId": { "type": "string" },
              "metric": { "type": "string", "enum": ["trust", "suspicion", "affinity"] },
              "op": { "type": "string", "enum": ["=", "!=", ">", ">=", "<", "<="] },
              "value": { "type": "number" }
            }
          }
        }
      ],
      "additionalProperties": true
    },
    "effect": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "stat.add",
            "stat.set",
            "suspicion.add",
            "flag.set",
            "relationship.add",
            "time.advance",
            "milestone.complete",
            "node.jump",
            "gameover.trigger"
          ]
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "stat.add" } } },
          "then": {
            "required": ["path", "value"],
            "properties": {
              "path": {
                "type": "string",
                "enum": ["stats.alibi", "stats.intel", "stats.morality", "stats.stress"]
              },
              "value": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "stat.set" } } },
          "then": {
            "required": ["path", "value"],
            "properties": {
              "path": {
                "type": "string",
                "enum": ["stats.alibi", "stats.intel", "stats.morality", "stats.stress"]
              },
              "value": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "suspicion.add" } } },
          "then": {
            "required": ["value"],
            "properties": {
              "value": { "type": "number" },
              "reason": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "flag.set" } } },
          "then": {
            "required": ["key", "value"],
            "properties": {
              "key": { "type": "string" },
              "value": {}
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "relationship.add" } } },
          "then": {
            "required": ["characterId", "metric", "value"],
            "properties": {
              "characterId": { "type": "string" },
              "metric": { "type": "string", "enum": ["trust", "suspicion", "affinity"] },
              "value": { "type": "number" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "time.advance" } } },
          "then": {
            "required": ["blocks"],
            "properties": {
              "blocks": { "type": "integer", "minimum": 1 }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "milestone.complete" } } },
          "then": {
            "required": ["milestoneId"],
            "properties": {
              "milestoneId": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "node.jump" } } },
          "then": {
            "required": ["nodeId"],
            "properties": {
              "nodeId": { "type": "string" }
            }
          }
        },
        {
          "if": { "properties": { "type": { "const": "gameover.trigger" } } },
          "then": {
            "required": ["reason"],
            "properties": {
              "reason": {
                "type": "string",
                "enum": ["suspicion-max", "canon-failure", "captured", "ending"]
              },
              "detail": { "type": "string" }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  }
}
