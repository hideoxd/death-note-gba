  "nodes": {
    "canon2_open_001": {
      "id": "canon2_open_001",
      "type": "scene",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "The Raye Penber operation begins: identify, control, and erase FBI tails.",
        "Every move trades information gain for exposure risk."
      ],
      "next": "canon2_milestone_001"
    },
    "canon2_milestone_001": {
      "id": "canon2_milestone_001",
      "type": "choice",
      "speaker": "light",
      "portrait": "light_focus",
      "location": "train_line",
      "text": [
        "The Raye sequence is a three-step gambit: identify target, force compliance, execute cleanly.",
        "Stall too long and canon fractures. Rush and suspicion spikes."
      ],
      "choices": [
        {
          "id": "track_fbi_pattern",
          "label": "Map FBI surveillance routes and identify Raye Penber",
          "requirements": [
            { "type": "flag.is", "key": "raye_identified", "value": false }
          ],
          "effects": [
            { "type": "flag.set", "key": "raye_identified", "value": true },
            { "type": "stat.add", "path": "stats.intel", "value": 2 },
            { "type": "suspicion.add", "value": 1, "reason": "intel_activity_spike" },
            { "type": "time.advance", "blocks": 1 }
          ],
          "next": "canon2_milestone_001"
        },
        {
          "id": "prepare_bus_script",
          "label": "Prepare bus-jacking script and control window",
          "requirements": [
            { "type": "flag.is", "key": "raye_identified", "value": true },
            { "type": "flag.is", "key": "raye_controlled", "value": false }
          ],
          "effects": [
            { "type": "flag.set", "key": "raye_controlled", "value": true },
            { "type": "stat.add", "path": "stats.stress", "value": 2 },
            { "type": "suspicion.add", "value": 2, "reason": "execution_pattern" },
            { "type": "time.advance", "blocks": 1 }
          ],
          "next": "canon2_milestone_001"
        },
        {
          "id": "execute_raye",
          "label": "Force Raye to write FBI names, then eliminate him",
          "requirements": [
            { "type": "flag.is", "key": "raye_identified", "value": true },
            { "type": "flag.is", "key": "raye_controlled", "value": true },
            {
              "type": "time.window",
              "dayMin": 10,
              "dayMax": 14,
              "blocks": ["morning", "afternoon", "night"]
            }
          ],
          "effects": [
            { "type": "flag.set", "key": "raye_executed", "value": true },
            { "type": "milestone.complete", "milestoneId": "RAYE_PENBER_INCIDENT" },
            { "type": "time.advance", "blocks": 1 }
          ],
          "next": "canon2_misa_entry_001"
        },
        {
          "id": "maintain_cover",
          "label": "Maintain family cover and reduce pressure",
          "effects": [
            { "type": "stat.add", "path": "stats.alibi", "value": 2 },
            { "type": "suspicion.add", "value": -1, "reason": "family_cover" },
            { "type": "time.advance", "blocks": 1 }
          ],
          "next": "canon2_milestone_001"
        },
        {
          "id": "miss_window",
          "label": "Abort operation",
          "effects": [
            {
              "type": "gameover.trigger",
              "reason": "canon-failure",
              "detail": "Raye Penber sequence was not completed in canon structure."
            }
          ],
          "next": "canon2_failure_001"
        }
      ]
    },
    "canon2_misa_entry_001": {
      "id": "canon2_misa_entry_001",
      "type": "scene",
      "speaker": "system",
      "location": "light_bedroom",
      "text": [
        "Misa Amane enters with Shinigami Eyes. Rem will sacrifice herself to protect Misa.",
        "Light gains leverage, but one impulsive move can burn the timeline."
      ],
      "onEnter": [
        { "type": "flag.set", "key": "misa_second_kira_active", "value": true }
      ],
      "next": "canon2_system_001"
    },
    "canon2_system_001": {
      "id": "canon2_system_001",
      "type": "system",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "Arc II complete: Raye operation succeeded and Misa enters play.",
        "Next arc covers memory-loss gamble, Yotsuba detour, and L's downfall."
      ],
      "next": null
    },
    "canon2_failure_001": {
      "id": "canon2_failure_001",
      "type": "system",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "Canon puzzle failed.",
        "Raye operation diverged and timeline collapsed."
      ],
      "next": null
    }
  }
