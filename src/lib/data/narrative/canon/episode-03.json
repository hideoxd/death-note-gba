{
  "meta": {
    "id": "canon-episode-03",
    "version": 2,
    "mode": "anime-canon",
    "startNodeId": "canon3_open_001"
  },
  "nodes": {
    "canon3_open_001": {
      "id": "canon3_open_001",
      "type": "scene",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "Arc III begins: Misa and Rem escalate the board while L closes in.",
        "Light must run the memory-loss gamble to reset suspicion and reclaim control."
      ],
      "next": "canon3_misa_control_001"
    },
    "canon3_misa_control_001": {
      "id": "canon3_misa_control_001",
      "type": "choice",
      "speaker": "light",
      "portrait": "light_focus",
      "location": "light_bedroom",
      "text": [
        "Misa's Shinigami Eyes are decisive but her impulses are unstable.",
        "Control her or lose investigative parity."
      ],
      "choices": [
        {
          "id": "use_misa_controlled",
          "label": "Use Misa as a tightly controlled asset",
          "effects": [
            { "type": "flag.set", "key": "misa_controlled", "value": true },
            { "type": "stat.add", "path": "stats.intel", "value": 2 },
            { "type": "suspicion.add", "value": 1, "reason": "intel_activity_spike" }
          ],
          "next": "canon3_memory_plan_001"
        },
        {
          "id": "trust_misa_fully",
          "label": "Let Misa operate independently",
          "effects": [
            {
              "type": "gameover.trigger",
              "reason": "canon-failure",
              "detail": "Misa's uncontrolled actions break the canon investigation path."
            }
          ],
          "next": "canon3_fail_001"
        }
      ]
    },
    "canon3_memory_plan_001": {
      "id": "canon3_memory_plan_001",
      "type": "choice",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "Light relinquishes notebook ownership and loses all notebook memories.",
        "As an actually innocent Light, he works beside L until the notebook resurfaces."
      ],
      "choices": [
        {
          "id": "execute_memory_plan",
          "label": "Execute ownership drop and enter confinement plan",
          "effects": [
            { "type": "flag.set", "key": "memory_plan_executed", "value": true },
            { "type": "stat.add", "path": "stats.alibi", "value": 4 },
            { "type": "suspicion.add", "value": -3, "reason": "normal_routine" },
            { "type": "time.advance", "blocks": 2 }
          ],
          "next": "canon3_yotsuba_001"
        },
        {
          "id": "skip_memory_plan",
          "label": "Avoid memory-loss plan",
          "effects": [
            {
              "type": "gameover.trigger",
              "reason": "canon-failure",
              "detail": "Without memory loss, the Yotsuba detour and recovery chain cannot form."
            }
          ],
          "next": "canon3_fail_001"
        }
      ]
    },
    "canon3_yotsuba_001": {
      "id": "canon3_yotsuba_001",
      "type": "scene",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "The notebook reaches Yotsuba executive Higuchi, creating a temporary third-party Kira.",
        "Light and L chase Higuchi together while innocent-Light state holds."
      ],
      "onEnter": [
        { "type": "flag.set", "key": "yotsuba_arc_active", "value": true }
      ],
      "next": "canon3_higuchi_001"
    },
    "canon3_higuchi_001": {
      "id": "canon3_higuchi_001",
      "type": "choice",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "At arrest, Light touches the notebook and memories flood back.",
        "He must secure ownership immediately to preserve cover."
      ],
      "choices": [
        {
          "id": "recover_memory_and_kill_higuchi",
          "label": "Reclaim notebook and eliminate Higuchi instantly",
          "effects": [
            { "type": "flag.set", "key": "higuchi_captured", "value": true },
            { "type": "milestone.complete", "milestoneId": "YOTSUBA_MEMORY_PLAN" },
            { "type": "suspicion.add", "value": 1, "reason": "handoff_cleanup" },
            { "type": "time.advance", "blocks": 1 }
          ],
          "next": "canon3_rem_checkmate_001"
        },
        {
          "id": "hesitate_on_higuchi",
          "label": "Delay and preserve legal process",
          "effects": [
            {
              "type": "gameover.trigger",
              "reason": "canon-failure",
              "detail": "Delayed recovery lets evidence paths drift away from canon cover logic."
            }
          ],
          "next": "canon3_fail_001"
        }
      ]
    },
    "canon3_rem_checkmate_001": {
      "id": "canon3_rem_checkmate_001",
      "type": "choice",
      "speaker": "light",
      "portrait": "light_smirk",
      "location": "taskforce_hq",
      "text": [
        "Light corners Rem by placing Misa under unavoidable suspicion.",
        "If Rem acts to protect Misa, she kills L and dies by Shinigami law."
      ],
      "choices": [
        {
          "id": "corner_rem",
          "label": "Force Rem's sacrifice to remove L",
          "effects": [
            { "type": "flag.set", "key": "l_dead", "value": true },
            { "type": "flag.set", "key": "rem_dead", "value": true },
            { "type": "milestone.complete", "milestoneId": "L_DEATH_EVENT" },
            { "type": "suspicion.add", "value": -4, "reason": "cover_shift" },
            { "type": "time.advance", "blocks": 1 }
          ],
          "next": "canon3_timeskip_001"
        },
        {
          "id": "spare_l",
          "label": "Do not trigger Rem",
          "effects": [
            {
              "type": "gameover.trigger",
              "reason": "canon-failure",
              "detail": "L survives long enough to expose Light's contradictions."
            }
          ],
          "next": "canon3_fail_001"
        }
      ]
    },
    "canon3_timeskip_001": {
      "id": "canon3_timeskip_001",
      "type": "scene",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "Five years pass. Light becomes the new L while secretly ruling as Kira.",
        "Mello and Near begin the successor-era counteroffensive."
      ],
      "onEnter": [
        { "type": "flag.set", "key": "timeskip_started", "value": true },
        { "type": "time.advance", "blocks": 6 }
      ],
      "next": "canon3_proxy_setup_001"
    },
    "canon3_proxy_setup_001": {
      "id": "canon3_proxy_setup_001",
      "type": "choice",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "Light outsources execution to Teru Mikami and messaging to Kiyomi Takada.",
        "A stable proxy chain is mandatory before Yellow Box."
      ],
      "choices": [
        {
          "id": "deploy_mikami",
          "label": "Appoint Mikami as execution proxy",
          "effects": [
            { "type": "flag.set", "key": "mikami_proxy_active", "value": true },
            { "type": "stat.add", "path": "stats.intel", "value": 2 },
            { "type": "suspicion.add", "value": 1, "reason": "proxy_activity" }
          ],
          "next": "canon3_proxy_setup_002"
        },
        {
          "id": "act_alone",
          "label": "Continue solo operations",
          "effects": [
            {
              "type": "gameover.trigger",
              "reason": "canon-failure",
              "detail": "Without Mikami, Light cannot sustain late-game deniability."
            }
          ],
          "next": "canon3_fail_001"
        }
      ]
    },
    "canon3_proxy_setup_002": {
      "id": "canon3_proxy_setup_002",
      "type": "choice",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "Takada becomes the public signal channel between Light and Mikami.",
        "The chain must hold long enough for Near's trap to form."
      ],
      "choices": [
        {
          "id": "stabilize_takada_channel",
          "label": "Establish Takada as controlled message relay",
          "effects": [
            { "type": "flag.set", "key": "takada_channel_established", "value": true },
            { "type": "milestone.complete", "milestoneId": "PROXY_NETWORK_STABLE" },
            { "type": "stat.add", "path": "stats.alibi", "value": 1 },
            { "type": "time.advance", "blocks": 1 }
          ],
          "next": "canon3_mello_shock_001"
        },
        {
          "id": "direct_only_proxy",
          "label": "Avoid public relay and micromanage privately",
          "effects": [
            {
              "type": "gameover.trigger",
              "reason": "canon-failure",
              "detail": "Without Takada relay, the successor arc drifts off canon tempo."
            }
          ],
          "next": "canon3_fail_001"
        }
      ]
    },
    "canon3_mello_shock_001": {
      "id": "canon3_mello_shock_001",
      "type": "choice",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "Mello kidnaps Takada, forcing Mikami to move outside strict orders.",
        "That deviation lets Near identify the real notebook location."
      ],
      "choices": [
        {
          "id": "allow_mello_interference",
          "label": "Let the disruption play out and preserve timeline pressure",
          "effects": [
            { "type": "flag.set", "key": "mello_interference", "value": true },
            { "type": "stat.add", "path": "stats.stress", "value": 3 },
            { "type": "time.advance", "blocks": 1 }
          ],
          "next": "canon3_yellow_box_001"
        },
        {
          "id": "block_mello_route",
          "label": "Prevent Mello from entering the chain",
          "effects": [
            {
              "type": "gameover.trigger",
              "reason": "canon-failure",
              "detail": "Near never gets the notebook-switch opening without Mello's disruption."
            }
          ],
          "next": "canon3_fail_001"
        }
      ]
    },
    "canon3_yellow_box_001": {
      "id": "canon3_yellow_box_001",
      "type": "scene",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "Yellow Box warehouse: Mikami writes names, but nothing happens.",
        "Near reveals the switched notebook and exposes Light by omission."
      ],
      "onEnter": [
        { "type": "flag.set", "key": "yellow_box_triggered", "value": true },
        { "type": "milestone.complete", "milestoneId": "YELLOW_BOX_CONFRONTATION" }
      ],
      "next": "canon3_light_falls_001"
    },
    "canon3_light_falls_001": {
      "id": "canon3_light_falls_001",
      "type": "scene",
      "speaker": "ryuk",
      "portrait": "ryuk_grin",
      "location": "light_bedroom",
      "text": [
        "Exposed, Light reaches for a hidden notebook scrap but is shot by Matsuda.",
        "Ryuk ends the game himself: Light's name is written, and Kira dies."
      ],
      "onEnter": [
        { "type": "flag.set", "key": "light_dead", "value": true },
        {
          "type": "gameover.trigger",
          "reason": "ending",
          "detail": "Canon ending: Light falls after Yellow Box and Ryuk closes the notebook."
        }
      ],
      "next": null
    },
    "canon3_fail_001": {
      "id": "canon3_fail_001",
      "type": "system",
      "speaker": "system",
      "location": "taskforce_hq",
      "text": [
        "Canon route failed.",
        "One of the required gambits diverged from the original chain."
      ],
      "next": null
    }
  }
}
